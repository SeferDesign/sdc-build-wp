{
	"name": "sdc-build-wp",
	"version": "5.11.1",
	"description": "Custom WordPress build process.",
	"engines": {
		"node": ">=22"
	},
	"author": {
		"name": "Robert Sefer",
		"email": "rob@seferdesign.com",
		"url": "https://seferdesign.com"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/SeferDesign/sdc-build-wp.git"
	},
	"type": "module",
	"scripts": {
		"test": "node --test tests/*.test.js",
		"test:coverage": "node --experimental-test-coverage --test --test-coverage-include='lib/**/*.js' tests/*.test.js",
		"test:theme": "node --test tests/build.test.js tests/php.test.js",
		"build:theme": "cd tests/fixtures/theme && node ../../../index.js --builds=style,scripts,images",
		"build:theme:watch": "npm run build:theme -- --watch",
		"release": "node lib/release.js patch",
		"release:patch": "npm run release",
		"release:minor": "node lib/release.js minor",
		"release:major": "node lib/release.js major"
	},
	"bin": {
		"sdc-build-wp": "./index.js"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@stylistic/stylelint-plugin": "^5.3.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"@wordpress/scripts": "^36.0.0",
		"ajv": "^8.20.0",
		"autoprefixer": "^10.6.1",
		"browser-sync": "^3.0.4",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"ink": "^7.1.1",
		"postcss": "^8.5.28",
		"postcss-scss": "^4.0.9",
		"postcss-sort-media-queries": "^6.7.1",
		"prettier": "^3.9.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sass": "^1.105.1",
		"sharp": "^0.35.5",
		"stylelint": "^17.16.0",
		"stylelint-use-logical": "^2.1.3",
		"svgo": "^4.1.0",
		"tail": "^2.2.6",
		"webpack": "^5.111.1",
		"yargs": "^18.2.0"
	}
}
